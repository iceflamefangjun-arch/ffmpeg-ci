+/* Disk record layouts must agree in libdvdread, libdvdnav and FFmpeg.
+ * In particular, MSVC unsigned-int bitfields must not enlarge byte fields. */
+#define DVDREAD_LAYOUT_ASSERT(name, condition) \
+  typedef char dvdread_layout_##name[(condition) ? 1 : -1]
+DVDREAD_LAYOUT_ASSERT(dvd_time, sizeof(dvd_time_t) == 4);
+DVDREAD_LAYOUT_ASSERT(video_attr, sizeof(video_attr_t) == 2);
+DVDREAD_LAYOUT_ASSERT(audio_attr, sizeof(audio_attr_t) == 8);
+DVDREAD_LAYOUT_ASSERT(subp_attr, sizeof(subp_attr_t) == 6);
+DVDREAD_LAYOUT_ASSERT(multichannel_ext, sizeof(multichannel_ext_t) == 24);
+DVDREAD_LAYOUT_ASSERT(cell_playback, sizeof(cell_playback_t) == 24);
+DVDREAD_LAYOUT_ASSERT(cell_time, offsetof(cell_playback_t, playback_time) == 4);
+DVDREAD_LAYOUT_ASSERT(cell_first_sector, offsetof(cell_playback_t, first_sector) == 8);
+DVDREAD_LAYOUT_ASSERT(cell_last_sector, offsetof(cell_playback_t, last_sector) == 20);
+DVDREAD_LAYOUT_ASSERT(cell_position, sizeof(cell_position_t) == 4);
+DVDREAD_LAYOUT_ASSERT(user_ops, sizeof(user_ops_t) == 4);
+DVDREAD_LAYOUT_ASSERT(pgc_disk_prefix, offsetof(pgc_t, command_tbl) == PGC_SIZE);
+DVDREAD_LAYOUT_ASSERT(pgci_mask, offsetof(pgci_srp_t, ptl_id_mask) == 2);
+DVDREAD_LAYOUT_ASSERT(pgci_start, offsetof(pgci_srp_t, pgc_start_byte) == 4);
+DVDREAD_LAYOUT_ASSERT(pgci_disk_prefix, offsetof(pgci_srp_t, pgc) == PGCI_SRP_SIZE);
+DVDREAD_LAYOUT_ASSERT(playback_type, sizeof(playback_type_t) == 1);
+DVDREAD_LAYOUT_ASSERT(title_info, sizeof(title_info_t) == 12);
+#undef DVDREAD_LAYOUT_ASSERT
+
 #endif /* LIBDVDREAD_IFO_TYPES_H */
