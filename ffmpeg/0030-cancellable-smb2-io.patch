+static int smb2_poll_once(URLContext *h, LIBSMB2Context *libsmb2)
+{
+#ifdef _WIN32
+    WSAPOLLFD pfd;
+    int events, ret, revents = 0;
+    t_socket fd;
+
+    fd = smb2_get_fd(libsmb2->ctx);
+    events = smb2_which_events(libsmb2->ctx);
+    memset(&pfd, 0, sizeof(pfd));
+    pfd.fd = (SOCKET)fd;
+    if (events & POLLIN)
+        pfd.events |= POLLRDNORM;
+    if (events & POLLOUT)
+        pfd.events |= POLLWRNORM;
+    ret = WSAPoll(&pfd, 1, 100);
+    if (ret < 0)
+        return AVERROR(EIO);
+    if (ret == 0)
+        return 0;
+    if (pfd.revents & (POLLRDNORM | POLLIN))
+        revents |= POLLIN;
+    if (pfd.revents & (POLLWRNORM | POLLOUT))
+        revents |= POLLOUT;
+    if (pfd.revents & (POLLERR | POLLHUP | POLLNVAL))
+        revents |= POLLERR;
+    if (smb2_service(libsmb2->ctx, revents) < 0)
+        return AVERROR(EIO);
+    return 0;
+#else
+    struct pollfd pfd;
+    int events, ret;
+    t_socket fd;
+
+    fd = smb2_get_fd(libsmb2->ctx);
+    events = smb2_which_events(libsmb2->ctx);
+    memset(&pfd, 0, sizeof(pfd));
+    pfd.fd = fd;
+    pfd.events = events;
+    ret = poll(&pfd, 1, 100);
+    if (ret < 0)
+        return AVERROR(errno);
+    if (ret == 0)
+        return 0;
+    if (smb2_service(libsmb2->ctx, pfd.revents) < 0)
+        return AVERROR(EIO);
+    return 0;
+#endif
+}
+
+static int smb2_wait_finish(URLContext *h, LIBSMB2Context *libsmb2, SMB2Wait **pwait,
+                            void **out_data)
+{
+    SMB2Wait *wait = *pwait;
+    int ret;
+
+    while (!wait->done) {
+        if (libsmb2->abort_request || ff_check_interrupt(&h->interrupt_callback)) {
+            wait->abandoned = 1;
+            *pwait = NULL;
+            destroy_smb2_context(libsmb2);
+            return AVERROR_EXIT;
+        }
+        if (h->rw_timeout > 0 && libsmb2->last_io_us > 0 &&
+            av_gettime_relative() - libsmb2->last_io_us > h->rw_timeout) {
+            wait->abandoned = 1;
+            *pwait = NULL;
+            destroy_smb2_context(libsmb2);
+            return AVERROR(ETIMEDOUT);
+        }
+        ret = smb2_poll_once(h, libsmb2);
+        if (ret < 0) {
+            wait->abandoned = 1;
+            *pwait = NULL;
+            destroy_smb2_context(libsmb2);
+            return ret;
+        }
+    }
+    if (out_data)
+        *out_data = wait->data;
+    ret = wait->status;
+    av_free(wait);
+    *pwait = NULL;
+    return ret;
+}
+
