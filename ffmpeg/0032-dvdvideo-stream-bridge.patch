From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shplayer <shplayer@local>
Date: Fri, 28 Aug 2026 00:00:00 +0800
Subject: [PATCH] dvdvideo stream bridge for remote ISO

diff --git a/libavformat/dvdvideodec.c b/libavformat/dvdvideodec.c
index f92c5ae..aaf64cd 100644
--- a/libavformat/dvdvideodec.c
+++ b/libavformat/dvdvideodec.c
@@ -53,6 +53,7 @@
 #include "dvdclut.h"
 #include "internal.h"
 #include "url.h"
+#include "disc_io.h"
 
 #define DVDVIDEO_MAX_PS_SEARCH_BLOCKS                   128
 #define DVDVIDEO_BLOCK_SIZE                             2048
@@ -162,6 +163,9 @@ typedef struct DVDVideoDemuxContext {
     dvd_reader_t                *dvdread;           /* handle to libdvdread */
     ifo_handle_t                *vmg_ifo;           /* handle to the VMG (VIDEO_TS.IFO) */
     ifo_handle_t                *vts_ifo;           /* handle to the active VTS (VTS_nn_n.IFO) */
+    DiscIO                      *disc_io;
+    DiscStreamPos               dvdread_pos;
+    DiscStreamPos               dvdnav_pos;
 
     /* playback control */
     int64_t                     first_pts;          /* the PTS of the first video keyframe */
@@ -220,6 +224,32 @@ static void dvdvideo_ifo_close(AVFormatContext *s)
 
     if (c->dvdread)
         DVDClose(c->dvdread);
+
+    ff_disc_io_close(&c->disc_io);
+}
+
+static int dvdvideo_is_url_source(const char *url)
+{
+    return av_strstart(url, "http:", NULL) ||
+           av_strstart(url, "https:", NULL) ||
+           av_strstart(url, "smb:", NULL) ||
+           av_strstart(url, "smb2:", NULL);
+}
+
+static int dvdvideo_ensure_disc_io(AVFormatContext *s)
+{
+    DVDVideoDemuxContext *c = s->priv_data;
+    int err = 0;
+    if (c->disc_io)
+        return 0;
+    c->disc_io = ff_disc_io_open(s->url, NULL, s->interrupt_callback, 0, &err);
+    if (!c->disc_io)
+        return err < 0 ? err : AVERROR(EIO);
+    c->dvdread_pos.io = c->disc_io;
+    c->dvdread_pos.pos = 0;
+    c->dvdnav_pos.io = c->disc_io;
+    c->dvdnav_pos.pos = 0;
+    return 0;
 }
 
 static int dvdvideo_ifo_open(AVFormatContext *s)
@@ -230,7 +260,17 @@ static int dvdvideo_ifo_open(AVFormatContext *s)
     title_info_t title_info;
 
     dvdread_log_cb = (dvd_logger_cb) { .pf_log = dvdvideo_libdvdread_log };
-    c->dvdread = DVDOpen2(s, &dvdread_log_cb, s->url);
+    if (dvdvideo_is_url_source(s->url)) {
+        dvd_reader_stream_cb stream_cb = {0};
+        int ret = dvdvideo_ensure_disc_io(s);
+        if (ret < 0)
+            return ret;
+        stream_cb.pf_seek = ff_disc_stream_seek;
+        stream_cb.pf_read = ff_disc_stream_read;
+        c->dvdread = DVDOpenStream2(&c->dvdread_pos, &dvdread_log_cb, &stream_cb);
+    } else {
+        c->dvdread = DVDOpen2(s, &dvdread_log_cb, s->url);
+    }
 
     if (!c->dvdread) {
         av_log(s, AV_LOG_ERROR, "Unable to open the DVD-Video structure\n");
@@ -524,7 +564,18 @@ static int dvdvideo_play_open(AVFormatContext *s, DVDVideoPlaybackState *state)
     pgc_t *pgc;
 
     dvdnav_log_cb = (dvdnav_logger_cb) { .pf_log = dvdvideo_libdvdnav_log };
-    dvdnav_open_status = dvdnav_open2(&state->dvdnav, s, &dvdnav_log_cb, s->url);
+    if (dvdvideo_is_url_source(s->url)) {
+        dvdnav_stream_cb stream_cb = {0};
+        int ret = dvdvideo_ensure_disc_io(s);
+        if (ret < 0)
+            return ret;
+        stream_cb.pf_seek = ff_disc_stream_seek;
+        stream_cb.pf_read = ff_disc_stream_read;
+        dvdnav_open_status = dvdnav_open_stream2(&state->dvdnav, &c->dvdnav_pos,
+                                                 &dvdnav_log_cb, &stream_cb);
+    } else {
+        dvdnav_open_status = dvdnav_open2(&state->dvdnav, s, &dvdnav_log_cb, s->url);
+    }
 
     if (!state->dvdnav                                                          ||
         dvdnav_open_status != DVDNAV_STATUS_OK                                  ||
