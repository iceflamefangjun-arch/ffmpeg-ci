diff --git a/libavformat/lrucache.c b/libavformat/lrucache.c
new file mode 100644
index 0000000..ea7930b
--- /dev/null
+++ b/libavformat/lrucache.c
@@ -0,0 +1,112 @@
+#include "lrucache.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+// 定义 LRU 缓存结构
+typedef struct LRUCache {
+    int capacity;
+    int size;
+    DLinkedNode *head;
+    DLinkedNode *tail;
+} LRUCache;
+
+// 创建新的双向链表节点
+static DLinkedNode *newDLinkedNode(int64_t offset, uint8_t *buffer, int64_t buffer_size)
+{
+    DLinkedNode *node = (DLinkedNode *)malloc(sizeof(DLinkedNode));
+    node->offset = offset;
+    node->buffer = buffer;
+    node->buffer_size = buffer_size;
+    node->prev = NULL;
+    node->next = NULL;
+    return node;
+}
+
+// 创建 LRU 缓存
+LRUCache *lRUCacheCreate(int capacity)
+{
+    LRUCache *cache = (LRUCache *)malloc(sizeof(LRUCache));
+    cache->capacity = capacity;
+    cache->size = 0;
+    cache->head = newDLinkedNode(0, NULL, 0);
+    cache->tail = newDLinkedNode(0, NULL, 0);
+    cache->head->next = cache->tail;
+    cache->tail->prev = cache->head;
+    return cache;
+}
+
+// 将节点移动到链表头部
+static void moveToHead(LRUCache *obj, DLinkedNode *node)
+{
+    if (node->prev) {
+        node->prev->next = node->next;
+    }
+    if (node->next) {
+        node->next->prev = node->prev;
+    }
+
+    node->next = obj->head->next;
+    node->prev = obj->head;
+    obj->head->next->prev = node;
+    obj->head->next = node;
+}
+
+// 删除链表尾部节点
+static void removeTail(LRUCache *obj)
+{
+    DLinkedNode *removed = obj->tail->prev;
+    removed->prev->next = obj->tail;
+    obj->tail->prev = removed->prev;
+    free(removed->buffer);
+    free(removed);
+    obj->size--;
+}
+
+// 获取缓存中的节点
+DLinkedNode *lRUCacheGet(LRUCache *obj, int64_t offset, int64_t size)
+{
+    DLinkedNode *current = obj->head->next;
+    while (current != obj->tail) {
+        if ((current->offset <= offset) &&
+            (current->offset + current->buffer_size >= offset + size)) {
+            moveToHead(obj, current);
+            return current;
+        }
+        current = current->next;
+    }
+    return NULL;
+}
+
+// 向缓存中插入键值对
+void lRUCachePut(LRUCache *obj, int64_t offset, uint8_t *buffer, int64_t buffer_size)
+{
+    DLinkedNode *current = obj->head->next;
+
+    if (obj->size == obj->capacity) {
+        removeTail(obj);
+    }
+
+    DLinkedNode *newNode = newDLinkedNode(offset, buffer, buffer_size);
+    newNode->next = obj->head->next;
+    newNode->prev = obj->head;
+    obj->head->next->prev = newNode;
+    obj->head->next = newNode;
+    obj->size++;
+}
+
+// 释放 LRU 缓存的内存
+void lRUCacheFree(LRUCache *obj)
+{
+    DLinkedNode *current = obj->head;
+    while (current != NULL) {
+        DLinkedNode *next = current->next;
+        if (current->buffer) {
+            free(current->buffer);
+        }
+        free(current);
+        current = next;
+    }
+    free(obj);
+}
