+static int umd_audio_packet(AVFormatContext *s, AVPacket *pkt)
+{
+    MpegDemuxContext *m = s->priv_data;
+    AVStream *st = NULL;
+    int frame_size;
+    int payload_size;
+    int ret;
+
+    if (m->umd_audio_size < 8)
+        return AVERROR(EAGAIN);
+    if (m->umd_audio[0] != 0x0f || m->umd_audio[1] != 0xd0) {
+        int offset;
+        for (offset = 1; offset + 1 < m->umd_audio_size; offset++) {
+            if (m->umd_audio[offset] == 0x0f &&
+                m->umd_audio[offset + 1] == 0xd0)
+                break;
+        }
+        av_log(s, AV_LOG_DEBUG,
+               "Resynchronizing UMD ATRAC3+ stream after %d bytes\n", offset);
+        memmove(m->umd_audio, m->umd_audio + offset,
+                m->umd_audio_size - offset);
+        m->umd_audio_size -= offset;
+        return AVERROR(EAGAIN);
+    }
+
+    frame_size = ((AV_RB16(m->umd_audio + 2) & 0x3ff) << 3) + 8;
+    if (frame_size <= 8 || frame_size > m->umd_audio_size)
+        return AVERROR(EAGAIN);
+
+    for (unsigned i = 0; i < s->nb_streams; i++) {
+        if (s->streams[i]->id == 0x08) {
+            st = s->streams[i];
+            break;
+        }
+    }
+    if (!st)
+        return AVERROR_STREAM_NOT_FOUND;
+
+    payload_size = frame_size - 8;
+    ret = av_new_packet(pkt, payload_size);
+    if (ret < 0)
+        return ret;
+    memcpy(pkt->data, m->umd_audio + 8, payload_size);
+    memmove(m->umd_audio, m->umd_audio + frame_size,
+            m->umd_audio_size - frame_size);
+    m->umd_audio_size -= frame_size;
+
+    st->codecpar->block_align = payload_size;
+    pkt->pts = m->umd_audio_pts;
+    pkt->dts = m->umd_audio_dts;
+    pkt->stream_index = st->index;
+    m->umd_audio_pts = AV_NOPTS_VALUE;
+    m->umd_audio_dts = AV_NOPTS_VALUE;
+    return 0;
+}
+
+static int umd_append_audio(AVFormatContext *s, int len,
+                            int64_t pts, int64_t dts)
+{
+    MpegDemuxContext *m = s->priv_data;
+    int needed = m->umd_audio_size + len;
+    int ret;
+
+    if (needed > m->umd_audio_allocated) {
+        int allocated = FFMAX(needed, m->umd_audio_allocated * 2);
+        uint8_t *buffer = av_realloc(m->umd_audio, allocated);
+        if (!buffer)
+            return AVERROR(ENOMEM);
+        m->umd_audio = buffer;
+        m->umd_audio_allocated = allocated;
+    }
+    if (!m->umd_audio_size) {
+        m->umd_audio_pts = pts;
+        m->umd_audio_dts = dts;
+    }
+    ret = avio_read(s->pb, m->umd_audio + m->umd_audio_size, len);
+    if (ret < 0)
+        return ret;
+    m->umd_audio_size += ret;
+    return ret == len ? 0 : AVERROR_EOF;
+}
