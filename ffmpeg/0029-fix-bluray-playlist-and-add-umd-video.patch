+static void umd_audio_reset(UmdAudioState *audio)
+{
+    audio->size = 0;
+    audio->pts = audio->dts = AV_NOPTS_VALUE;
+    audio->next_offset = -1;
+    audio->next_pts = audio->next_dts = AV_NOPTS_VALUE;
+}
+
+static void umd_audio_consume(UmdAudioState *audio, int size)
+{
+    memmove(audio->data, audio->data + size, audio->size - size);
+    audio->size -= size;
+    if (audio->next_offset >= 0)
+        audio->next_offset = FFMAX(0, audio->next_offset - size);
+}
+
+static int umd_audio_packet(AVStream *st, AVPacket *pkt)
+{
+    UmdAudioState *audio = st->priv_data;
+    const AVRational sample_time_base = { 1, 44100 };
+    int frame_size, ret;
+
+    while (audio->size >= 8) {
+        if (audio->data[0] != 0x0f || audio->data[1] != 0xd0) {
+            int offset;
+            for (offset = 1; offset + 1 < audio->size; offset++) {
+                if (audio->data[offset] == 0x0f && audio->data[offset + 1] == 0xd0)
+                    break;
+            }
+            /* Keep the final byte: the sync word can cross PES packets. */
+            umd_audio_consume(audio, offset);
+            audio->pts = audio->dts = AV_NOPTS_VALUE;
+            continue;
+        }
+        frame_size = ((AV_RB16(audio->data + 2) & 0x3ff) << 3) + 8;
+        if (frame_size == 8) {
+            umd_audio_consume(audio, 2);
+            continue;
+        }
+        if (frame_size > audio->size)
+            break;
+        ret = av_new_packet(pkt, frame_size - 8);
+        if (ret < 0)
+            return ret;
+        if (audio->next_offset == 0) {
+            audio->pts = audio->next_pts;
+            audio->dts = audio->next_dts;
+            audio->next_offset = -1;
+        }
+        memcpy(pkt->data, audio->data + 8, pkt->size);
+        pkt->pts = audio->pts;
+        pkt->dts = audio->dts;
+        pkt->duration = av_rescale_q(2048, sample_time_base, st->time_base);
+        pkt->stream_index = st->index;
+        st->codecpar->block_align = pkt->size;
+        umd_audio_consume(audio, frame_size);
+        if (audio->pts != AV_NOPTS_VALUE)
+            audio->pts = av_add_stable(st->time_base, audio->pts, sample_time_base, 2048);
+        if (audio->dts != AV_NOPTS_VALUE)
+            audio->dts = av_add_stable(st->time_base, audio->dts, sample_time_base, 2048);
+        return 0;
+    }
+    return AVERROR(EAGAIN);
+}
+
+static int umd_append_audio(AVFormatContext *s, AVStream *st, int len,
+                            int first_frame_offset, int64_t pts, int64_t dts)
+{
+    UmdAudioState *audio = st->priv_data;
+    uint8_t *data;
+    int ret;
+
+    if (len > INT_MAX - audio->size)
+        return AVERROR_INVALIDDATA;
+    data = av_fast_realloc(audio->data, &audio->allocated, audio->size + len);
+    if (!data)
+        return AVERROR(ENOMEM);
+    audio->data = data;
+    /* Preserve a timestamp belonging to a frame split across PES packets. */
+    if (audio->next_offset == 0) {
+        audio->pts = audio->next_pts;
+        audio->dts = audio->next_dts;
+        audio->next_offset = -1;
+    }
+    /* PES timestamps describe the first new frame, not a preceding fragment. */
+    if (first_frame_offset < len && (pts != AV_NOPTS_VALUE || dts != AV_NOPTS_VALUE)) {
+        audio->next_offset = audio->size + first_frame_offset;
+        audio->next_pts = pts;
+        audio->next_dts = dts;
+    }
+    ret = avio_read(s->pb, audio->data + audio->size, len);
+    if (ret < 0)
+        return ret;
+    audio->size += ret;
+    return ret == len ? 0 : AVERROR_EOF;
+}
+
+static void umd_audio_reset_all(AVFormatContext *s)
+{
+    for (unsigned i = 0; i < s->nb_streams; i++) {
+        AVStream *st = s->streams[i];
+        if (st->codecpar->codec_id == AV_CODEC_ID_ATRAC3P && st->priv_data)
+            umd_audio_reset(st->priv_data);
+    }
+}
