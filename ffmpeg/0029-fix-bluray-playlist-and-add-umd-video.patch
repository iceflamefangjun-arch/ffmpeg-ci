diff --git a/libavformat/umd.c b/libavformat/umd.c
new file mode 100644
index 0000000..f93c885
--- /dev/null
+++ b/libavformat/umd.c
@@ -0,0 +1,258 @@
+/*
+ * UMD Video ISO protocol
+ *
+ * This file is part of FFmpeg.
+ */
+
+#include <inttypes.h>
+#include <string.h>
+
+#include "libavutil/avstring.h"
+#include "libavutil/dict.h"
+#include "libavutil/error.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mem.h"
+#include "avformat.h"
+#include "url.h"
+#include "urldecode.h"
+
+#define ISO_SECTOR_SIZE 2048
+#define ISO_PVD_SECTOR  16
+#define ISO_ROOT_OFFSET 156
+
+typedef struct UmdContext {
+    URLContext *inner;
+    int64_t program_offset;
+    int64_t program_size;
+    int64_t position;
+    uint32_t program_extent;
+    char program_name[256];
+} UmdContext;
+
+typedef struct IsoEntry {
+    uint32_t extent;
+    uint32_t size;
+    int is_directory;
+    char name[256];
+} IsoEntry;
+
+static int umd_read_at(UmdContext *umd, int64_t offset, uint8_t *buf, int size)
+{
+    int total = 0;
+    int64_t pos = ffurl_seek(umd->inner, offset, SEEK_SET);
+
+    if (pos < 0)
+        return (int)pos;
+    while (total < size) {
+        int ret = ffurl_read(umd->inner, buf + total, size - total);
+        if (ret <= 0)
+            return ret < 0 ? ret : AVERROR_EOF;
+        total += ret;
+    }
+    return 0;
+}
+
+static void iso_entry_from_record(IsoEntry *entry, const uint8_t *record)
+{
+    int name_length = record[32];
+
+    entry->extent = AV_RL32(record + 2);
+    entry->size = AV_RL32(record + 10);
+    entry->is_directory = !!(record[25] & 2);
+    name_length = FFMIN(name_length, (int)sizeof(entry->name) - 1);
+    memcpy(entry->name, record + 33, name_length);
+    entry->name[name_length] = '\0';
+    if (name_length > 2 && entry->name[name_length - 2] == ';' &&
+        entry->name[name_length - 1] == '1')
+        entry->name[name_length - 2] = '\0';
+}
+
+static int iso_scan_directory(UmdContext *umd, const IsoEntry *directory,
+                              const char *wanted_name, int wanted_directory,
+                              IsoEntry *result, int select_largest_mps)
+{
+    uint8_t sector[ISO_SECTOR_SIZE];
+    uint32_t offset = 0;
+    int found = 0;
+
+    while (offset < directory->size) {
+        uint32_t sector_offset = offset % ISO_SECTOR_SIZE;
+        uint32_t sector_base = offset - sector_offset;
+        int ret = umd_read_at(umd,
+                              (int64_t)directory->extent * ISO_SECTOR_SIZE + sector_base,
+                              sector, sizeof(sector));
+        if (ret < 0)
+            return ret;
+
+        while (sector_offset < ISO_SECTOR_SIZE && offset < directory->size) {
+            const uint8_t *record = sector + sector_offset;
+            int record_length = record[0];
+            IsoEntry entry;
+
+            if (!record_length) {
+                offset = sector_base + ISO_SECTOR_SIZE;
+                break;
+            }
+            if (record_length < 34 || sector_offset + record_length > ISO_SECTOR_SIZE ||
+                33 + record[32] > record_length)
+                return AVERROR_INVALIDDATA;
+
+            iso_entry_from_record(&entry, record);
+            if (entry.name[0] != '\0' && entry.name[0] != '\1') {
+                if (select_largest_mps) {
+                    size_t length = strlen(entry.name);
+                    if (!entry.is_directory && length > 4 &&
+                        !av_strcasecmp(entry.name + length - 4, ".MPS") &&
+                        (!found || entry.size > result->size)) {
+                        *result = entry;
+                        found = 1;
+                    }
+                } else if (entry.is_directory == wanted_directory &&
+                           !av_strcasecmp(entry.name, wanted_name)) {
+                    *result = entry;
+                    return 0;
+                }
+            }
+
+            sector_offset += record_length;
+            offset += record_length;
+        }
+    }
+
+    return found ? 0 : AVERROR(ENOENT);
+}
+
+static int umd_open(URLContext *h, const char *url, int flags,
+                    AVDictionary **options)
+{
+    UmdContext *umd = h->priv_data;
+    const char *source = url;
+    char *decoded = NULL;
+    uint8_t pvd[ISO_SECTOR_SIZE];
+    IsoEntry root = { 0 };
+    IsoEntry umd_video;
+    IsoEntry stream;
+    IsoEntry program;
+    char volume_id[33];
+    int ret;
+
+    av_strstart(url, "umd://", &source);
+    decoded = ff_urldecode(source, 0);
+    if (!decoded)
+        return AVERROR(ENOMEM);
+
+    ret = ffurl_open_whitelist(&umd->inner, decoded, AVIO_FLAG_READ,
+                               &h->interrupt_callback, options,
+                               h->protocol_whitelist, h->protocol_blacklist, h);
+    av_free(decoded);
+    if (ret < 0)
+        return ret;
+
+    ret = umd_read_at(umd, (int64_t)ISO_PVD_SECTOR * ISO_SECTOR_SIZE,
+                      pvd, sizeof(pvd));
+    if (ret < 0)
+        goto fail;
+    if (pvd[0] != 1 || memcmp(pvd + 1, "CD001", 5) || pvd[6] != 1) {
+        ret = AVERROR_INVALIDDATA;
+        goto fail;
+    }
+
+    memcpy(volume_id, pvd + 40, 32);
+    volume_id[32] = '\0';
+    for (int i = 31; i >= 0 && volume_id[i] == ' '; --i)
+        volume_id[i] = '\0';
+    av_log(h, AV_LOG_INFO, "UMD Video ISO volume='%s'\n", volume_id);
+
+    if (pvd[ISO_ROOT_OFFSET] < 34 ||
+        33 + pvd[ISO_ROOT_OFFSET + 32] > pvd[ISO_ROOT_OFFSET]) {
+        ret = AVERROR_INVALIDDATA;
+        goto fail;
+    }
+    iso_entry_from_record(&root, pvd + ISO_ROOT_OFFSET);
+    ret = iso_scan_directory(umd, &root, "UMD_VIDEO", 1, &umd_video, 0);
+    if (ret < 0)
+        goto fail;
+    ret = iso_scan_directory(umd, &umd_video, "STREAM", 1, &stream, 0);
+    if (ret < 0)
+        goto fail;
+    ret = iso_scan_directory(umd, &stream, NULL, 0, &program, 1);
+    if (ret < 0)
+        goto fail;
+
+    umd->program_extent = program.extent;
+    umd->program_offset = (int64_t)program.extent * ISO_SECTOR_SIZE;
+    umd->program_size = program.size;
+    av_strlcpy(umd->program_name, program.name, sizeof(umd->program_name));
+    h->is_streamed = 0;
+    av_log(h, AV_LOG_INFO,
+           "UMD Video selected program %s extent=%u size=%"PRId64"\n",
+           umd->program_name, umd->program_extent, umd->program_size);
+    return 0;
+
+fail:
+    ffurl_closep(&umd->inner);
+    return ret;
+}
+
+static int umd_read(URLContext *h, unsigned char *buf, int size)
+{
+    UmdContext *umd = h->priv_data;
+    int64_t remaining = umd->program_size - umd->position;
+    int ret;
+
+    if (remaining <= 0)
+        return AVERROR_EOF;
+    size = (int)FFMIN(remaining, size);
+    ret = umd_read_at(umd, umd->program_offset + umd->position, buf, size);
+    if (ret < 0)
+        return ret;
+    umd->position += size;
+    return size;
+}
+
+static int64_t umd_seek(URLContext *h, int64_t pos, int whence)
+{
+    UmdContext *umd = h->priv_data;
+    int64_t target;
+
+    if (whence == AVSEEK_SIZE)
+        return umd->program_size;
+    if (whence == SEEK_SET)
+        target = pos;
+    else if (whence == SEEK_CUR)
+        target = umd->position + pos;
+    else if (whence == SEEK_END)
+        target = umd->program_size + pos;
+    else
+        return AVERROR(EINVAL);
+    if (target < 0 || target > umd->program_size)
+        return AVERROR(EINVAL);
+    umd->position = target;
+    return target;
+}
+
+static int umd_close(URLContext *h)
+{
+    UmdContext *umd = h->priv_data;
+    return ffurl_closep(&umd->inner);
+}
+
+static int umd_parse_priv(AVFormatContext *ic, URLContext *h)
+{
+    UmdContext *umd = h->priv_data;
+
+    av_dict_set(&ic->metadata, "umd_program", umd->program_name, 0);
+    av_dict_set_int(&ic->metadata, "umd_program_extent", umd->program_extent, 0);
+    av_dict_set_int(&ic->metadata, "umd_program_size", umd->program_size, 0);
+    return 0;
+}
+
+const URLProtocol ff_umd_protocol = {
+    .name           = "umd",
+    .url_open2      = umd_open,
+    .url_read       = umd_read,
+    .url_seek       = umd_seek,
+    .url_close      = umd_close,
+    .url_parse_priv = umd_parse_priv,
+    .priv_data_size = sizeof(UmdContext),
+};
