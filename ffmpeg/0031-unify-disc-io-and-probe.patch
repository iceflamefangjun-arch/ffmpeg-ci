From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shplayer <shplayer@local>
Date: Fri, 28 Aug 2026 00:00:00 +0800
Subject: [PATCH] unify disc io and probe

diff --git a/libavformat/Makefile b/libavformat/Makefile
index 1111111..2222222 100644
--- a/libavformat/Makefile
+++ b/libavformat/Makefile
@@ -21,6 +21,7 @@ OBJS = allformats.o         \
        avformat.o           \
        avio.o               \
        aviobuf.o            \
+       disc_io.o            \
        demux.o              \
        demux_utils.o        \
        dump.o               \
diff --git a/libavformat/disc_io.c b/libavformat/disc_io.c
new file mode 100644
index 0000000..28120c6
--- /dev/null
+++ b/libavformat/disc_io.c
@@ -0,0 +1,588 @@
+#include "config_components.h"
+
+#include "disc_io.h"
+
+#include "libavutil/avstring.h"
+#include "libavutil/bprint.h"
+#include "libavutil/error.h"
+#include "libavutil/mem.h"
+#include "libavutil/time.h"
+#include "libavformat/avio.h"
+#include "libavformat/internal.h"
+#include "libavformat/url.h"
+
+#include <errno.h>
+#include <inttypes.h>
+#include <string.h>
+
+#if CONFIG_BLURAY_PROTOCOL
+#include <libbluray/bluray.h>
+#endif
+#if CONFIG_DVDVIDEO_DEMUXER
+#include <dvdread/dvd_reader.h>
+#include <dvdread/ifo_read.h>
+#endif
+
+#define ISO_SECTOR_SIZE 2048
+
+struct DiscIO {
+    AVIOContext *pb;
+    AVIOInterruptCB interrupt_cb;
+    int64_t startup_deadline_us;
+    int64_t last_io_us;
+    int64_t size;
+    void *probe_id;
+    const char *probe_url; /* Borrowed only for the duration of av_disc_probe(). */
+    const char *stage;
+    int first_io_error;
+    int64_t read_calls;
+    int64_t bytes_read;
+};
+
+static int discio_interrupted(DiscIO *io)
+{
+    if (io->startup_deadline_us > 0 && av_gettime_relative() >= io->startup_deadline_us)
+        return AVERROR(ETIMEDOUT);
+    if (ff_check_interrupt(&io->interrupt_cb))
+        return AVERROR_EXIT;
+    return 0;
+}
+
+int ff_disc_io_read(DiscIO *io, int64_t offset, void *buf, int size)
+{
+    int ret, n = 0;
+    int64_t got = -1;
+
+    if (!io || !io->pb)
+        return AVERROR(EIO);
+    ++io->read_calls;
+    ret = discio_interrupted(io);
+    if (ret < 0)
+        goto done;
+    got = avio_seek(io->pb, offset, SEEK_SET);
+    if (got != offset) {
+        ret = got < 0 ? (int)got : AVERROR(ESPIPE);
+        goto done;
+    }
+    n = avio_read(io->pb, buf, size);
+    ret = n;
+    if (n > 0) {
+        io->last_io_us = av_gettime_relative();
+        io->bytes_read += n;
+    }
+
+done:
+    if (ret < size && !io->first_io_error) {
+        io->first_io_error = ret < 0 ? ret : AVERROR(EIO);
+        if (io->probe_id)
+            av_log(NULL, AV_LOG_WARNING,
+                   "[DiscProbe] id=%p stage=%s io_error=%d (%s) offset=%"PRId64
+                   " requested=%d seek_result=%"PRId64" actual=%d\n",
+                   io->probe_id, io->stage, io->first_io_error,
+                   av_err2str(io->first_io_error), offset, size, got, n);
+    }
+    return ret;
+}
+
+int64_t ff_disc_io_size(DiscIO *io)
+{
+    return io ? io->size : -1;
+}
+
+void ff_disc_io_close(DiscIO **pio)
+{
+    DiscIO *io;
+    if (!pio || !*pio)
+        return;
+    io = *pio;
+    if (io->pb)
+        avio_closep(&io->pb);
+    av_freep(pio);
+}
+
+DiscIO *ff_disc_io_open(const char *url, const AVDictionary *opts,
+                        AVIOInterruptCB interrupt_cb, int64_t startup_deadline_us,
+                        int *err)
+{
+    DiscIO *io;
+    AVDictionary *copy = NULL;
+    int ret;
+
+    io = av_mallocz(sizeof(*io));
+    if (!io) {
+        if (err)
+            *err = AVERROR(ENOMEM);
+        return NULL;
+    }
+    io->interrupt_cb = interrupt_cb;
+    io->startup_deadline_us = startup_deadline_us;
+    io->last_io_us = av_gettime_relative();
+    if (opts)
+        av_dict_copy(&copy, opts, 0);
+    if (!av_dict_get(copy, "protocol_whitelist", NULL, 0))
+        av_dict_set(&copy, "protocol_whitelist",
+                    "file,http,https,tcp,tls,crypto,smb2", 0);
+    ret = avio_open2(&io->pb, url, AVIO_FLAG_READ, &io->interrupt_cb, &copy);
+    av_dict_free(&copy);
+    if (ret < 0) {
+        av_free(io);
+        if (err)
+            *err = ret;
+        return NULL;
+    }
+    io->size = avio_size(io->pb);
+    return io;
+}
+
+int ff_disc_stream_seek(void *opaque, uint64_t offset)
+{
+    DiscStreamPos *p = opaque;
+    if (!p)
+        return -1;
+    p->pos = (int64_t)offset;
+    return 0;
+}
+
+int ff_disc_stream_read(void *opaque, void *buf, int size)
+{
+    DiscStreamPos *p = opaque;
+    int n;
+    if (!p || !p->io || size <= 0)
+        return -1;
+    n = ff_disc_io_read(p->io, p->pos, buf, size);
+    if (n > 0)
+        p->pos += n;
+    return n < 0 ? -1 : n;
+}
+
+static int map_open_error(int ret)
+{
+    if (ret >= 0)
+        return AV_DISC_ERROR_NONE;
+    if (ret == AVERROR_EXIT)
+        return AV_DISC_ERROR_CANCELLED;
+    if (ret == AVERROR(ETIMEDOUT))
+        return AV_DISC_ERROR_TIMEOUT;
+    if (ret == AVERROR(ESPIPE) || ret == AVERROR(EPIPE))
+        return AV_DISC_ERROR_NOT_SEEKABLE;
+    if (ret == AVERROR(EPERM) || ret == AVERROR(EACCES) ||
+        ret == AVERROR_HTTP_UNAUTHORIZED || ret == AVERROR_HTTP_FORBIDDEN)
+        return AV_DISC_ERROR_AUTHENTICATION_FAILED;
+    if (ret == AVERROR_INVALIDDATA)
+        return AV_DISC_ERROR_INVALID_DATA;
+    if (ret == AVERROR(ENOSYS))
+        return AV_DISC_ERROR_BACKEND_UNAVAILABLE;
+    return AV_DISC_ERROR_IO;
+}
+
+static int verify_random_seek(DiscIO *io)
+{
+    uint8_t first[16], again[16], far_buf[16];
+    int64_t far_off;
+    int ret;
+
+    if (io->size <= ISO_SECTOR_SIZE * 32)
+        return 0;
+
+    ret = ff_disc_io_read(io, 0, first, sizeof(first));
+    if (ret < (int)sizeof(first))
+        return ret < 0 ? ret : AVERROR(EIO);
+
+    far_off = 16LL * ISO_SECTOR_SIZE;
+    ret = ff_disc_io_read(io, far_off, far_buf, sizeof(far_buf));
+    if (ret < (int)sizeof(far_buf))
+        return ret < 0 ? ret : AVERROR(ESPIPE);
+    if (avio_tell(io->pb) != far_off + sizeof(far_buf))
+        return AVERROR(ESPIPE);
+
+    ret = ff_disc_io_read(io, 0, again, sizeof(again));
+    if (ret < (int)sizeof(again))
+        return ret < 0 ? ret : AVERROR(ESPIPE);
+    if (avio_tell(io->pb) != (int64_t)sizeof(again))
+        return AVERROR(ESPIPE);
+    if (memcmp(first, again, sizeof(first)) != 0)
+        return AVERROR(ESPIPE);
+    if (memcmp(first, far_buf, sizeof(first)) == 0)
+        return AVERROR(ESPIPE);
+    return 0;
+}
+
+typedef struct IsoDir {
+    uint32_t extent;
+    uint32_t size;
+} IsoDir;
+
+static int find_iso_dir(DiscIO *io, const IsoDir *parent, const char *wanted, IsoDir *out)
+{
+    uint8_t sector[ISO_SECTOR_SIZE];
+    uint32_t offset = 0;
+
+    while (offset < parent->size) {
+        uint32_t sector_offset = offset % ISO_SECTOR_SIZE;
+        uint32_t sector_base = offset - sector_offset;
+        uint32_t record_offset;
+        int ret = discio_interrupted(io);
+        if (ret < 0)
+            return ret;
+        ret = ff_disc_io_read(io,
+                              (int64_t)parent->extent * ISO_SECTOR_SIZE + sector_base,
+                              sector, sizeof(sector));
+        if (ret < (int)sizeof(sector))
+            return ret < 0 ? ret : AVERROR(EIO);
+        record_offset = sector_offset;
+        while (record_offset < ISO_SECTOR_SIZE && offset < parent->size) {
+            const uint8_t *record = sector + record_offset;
+            uint8_t record_len = record[0];
+            uint8_t name_len;
+            if (record_len == 0) {
+                offset = sector_base + ISO_SECTOR_SIZE;
+                break;
+            }
+            if (record_len < 34 || record_offset + record_len > ISO_SECTOR_SIZE)
+                return AVERROR_INVALIDDATA;
+            name_len = record[32];
+            if (33 + name_len > record_len)
+                return AVERROR_INVALIDDATA;
+            if ((record[25] & 2) && name_len > 0 && name_len < 128 &&
+                record[33] != 0 && record[33] != 1) {
+                char name[128] = {0};
+                memcpy(name, record + 33, name_len);
+                if (name_len > 2 && name[name_len - 2] == ';' && name[name_len - 1] == '1')
+                    name[name_len - 2] = 0;
+                if (!av_strcasecmp(name, wanted)) {
+                    memcpy(&out->extent, record + 2, 4);
+                    memcpy(&out->size, record + 10, 4);
+                    return 1;
+                }
+            }
+            record_offset += record_len;
+            offset += record_len;
+        }
+    }
+    return 0;
+}
+
+#if CONFIG_BLURAY_PROTOCOL
+static int discio_read_blocks(void *fs_handle, void *buf, int lba, int num_blocks)
+{
+    DiscIO *io = fs_handle;
+    int want = num_blocks * ISO_SECTOR_SIZE;
+    int n = ff_disc_io_read(io, (int64_t)lba * ISO_SECTOR_SIZE, buf, want);
+    if (n < 0)
+        return n;
+    return n / ISO_SECTOR_SIZE;
+}
+
+static int confirm_bluray(DiscIO *io)
+{
+    BLURAY *bd;
+    uint32_t titles = 0;
+    int opened = 0;
+    int ret = discio_interrupted(io);
+
+    io->stage = "bluray";
+    io->first_io_error = 0;
+    av_log(NULL, AV_LOG_INFO, "[DiscProbe] id=%p stage=bluray begin backend=read_blocks\n",
+           io->probe_id);
+    if (ret < 0)
+        goto done;
+    bd = bd_init();
+    if (!bd) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+    /* An empty device path is a Windows directory, not a stream source. */
+    opened = bd_open_stream(bd, io, discio_read_blocks);
+    ret = discio_interrupted(io);
+    if (opened && ret >= 0)
+        titles = bd_get_titles(bd, TITLES_RELEVANT, 0);
+    bd_close(bd);
+    ret = discio_interrupted(io);
+    if (ret >= 0 && !titles)
+        ret = io->first_io_error;
+
+done:
+    av_log(NULL, AV_LOG_INFO,
+           "[DiscProbe] id=%p stage=bluray opened=%d titles=%u raw_error=%d\n",
+           io->probe_id, opened, titles, ret);
+    return ret < 0 ? ret : titles > 0;
+}
+#endif
+
+#if CONFIG_DVDVIDEO_DEMUXER
+static void discio_dvd_log(void *opaque, dvd_logger_level_t level,
+                          const char *fmt, va_list args)
+{
+    DiscIO *io = ((DiscStreamPos *)opaque)->io;
+    AVBPrint buffer;
+    char *message = NULL;
+    char *safe;
+    const char *source = io->probe_url;
+    char *p;
+
+    if (level != DVD_LOGGER_LEVEL_ERROR && level != DVD_LOGGER_LEVEL_WARN)
+        return;
+    av_bprint_init(&buffer, 0, AV_BPRINT_SIZE_UNLIMITED);
+    av_vbprintf(&buffer, fmt, args);
+    if (!av_bprint_is_complete(&buffer)) {
+        av_bprint_finalize(&buffer, NULL);
+        return;
+    }
+    if (av_bprint_finalize(&buffer, &message) < 0)
+        return;
+    /* Redact before truncation so a long URL cannot leak credentials. */
+    av_strstart(source, "file:", &source);
+    safe = av_strireplace(message, source, "<source>");
+    av_free(message);
+    if (!safe)
+        return;
+    for (p = safe; *p; ++p)
+        if (*p == '\r' || *p == '\n')
+            *p = ' ';
+    av_log(NULL, AV_LOG_WARNING, "[DiscProbe] id=%p stage=dvd libdvdread_level=%d message=%.1024s\n",
+           io->probe_id, level, safe);
+    av_free(safe);
+}
+
+static int confirm_dvd(DiscIO *io)
+{
+    DiscStreamPos pos = { .io = io, .pos = 0 };
+    dvd_logger_cb logcb = { .pf_log = discio_dvd_log };
+    dvd_reader_stream_cb stream_cb = {0};
+    dvd_reader_t *dvd = NULL;
+    ifo_handle_t *vmg = NULL;
+    /* Match dvdvideo's native file/UNC entry; other protocols keep stream I/O. */
+    const char *protocol = avio_find_protocol_name(io->probe_url);
+    int native_file = protocol && !strcmp(protocol, "file");
+    int opened = 0, ok = 0, open_errno = 0;
+    int ret = discio_interrupted(io);
+
+    io->stage = "dvd";
+    io->first_io_error = 0;
+    av_log(NULL, AV_LOG_INFO, "[DiscProbe] id=%p stage=dvd begin backend=%s\n",
+           io->probe_id, native_file ? "file" : "stream");
+    if (ret < 0)
+        goto done;
+    errno = 0;
+    if (native_file) {
+        const char *path = io->probe_url;
+        av_strstart(path, "file:", &path);
+        dvd = DVDOpen2(&pos, &logcb, path);
+    } else {
+        stream_cb.pf_seek = ff_disc_stream_seek;
+        stream_cb.pf_read = ff_disc_stream_read;
+        dvd = DVDOpenStream2(&pos, &logcb, &stream_cb);
+    }
+    open_errno = errno;
+    opened = dvd != NULL;
+    ret = discio_interrupted(io);
+    if (ret < 0)
+        goto done;
+    if (!dvd) {
+        ret = io->first_io_error ? io->first_io_error :
+              (open_errno ? AVERROR(open_errno) : AVERROR(EIO));
+        goto done;
+    }
+    vmg = ifoOpen(dvd, 0);
+    ok = vmg && vmg->vmgi_mat;
+    ret = discio_interrupted(io);
+    if (ret >= 0 && !ok)
+        ret = io->first_io_error;
+
+done:
+    if (vmg)
+        ifoClose(vmg);
+    if (dvd)
+        DVDClose(dvd);
+    av_log(NULL, AV_LOG_INFO,
+           "[DiscProbe] id=%p stage=dvd opened=%d ifo=%d open_errno=%d raw_error=%d\n",
+           io->probe_id, opened, ok, open_errno, ret);
+    return ret < 0 ? ret : ok;
+}
+#endif
+
+static int classify_iso9660(DiscIO *io, const IsoDir *root, enum AVDiscImageType *type)
+{
+    IsoDir child, stream;
+    int ret;
+
+    ret = find_iso_dir(io, root, "UMD_VIDEO", &child);
+    if (ret < 0)
+        return ret;
+    if (ret > 0) {
+        ret = find_iso_dir(io, &child, "STREAM", &stream);
+        if (ret < 0)
+            return ret;
+        if (ret > 0) {
+            *type = AV_DISC_IMAGE_UMD_VIDEO;
+            return 0;
+        }
+    }
+
+    ret = find_iso_dir(io, root, "BDMV", &child);
+    if (ret < 0)
+        return ret;
+    if (ret > 0) {
+#if CONFIG_BLURAY_PROTOCOL
+        ret = confirm_bluray(io);
+        if (ret > 0) {
+            *type = AV_DISC_IMAGE_BLURAY;
+            return 0;
+        }
+        return ret < 0 ? ret : AVERROR_INVALIDDATA;
+#else
+        return AVERROR(ENOSYS);
+#endif
+    }
+
+    ret = find_iso_dir(io, root, "VIDEO_TS", &child);
+    if (ret < 0)
+        return ret;
+    if (ret > 0) {
+#if CONFIG_DVDVIDEO_DEMUXER
+        ret = confirm_dvd(io);
+        if (ret > 0) {
+            *type = AV_DISC_IMAGE_DVD;
+            return 0;
+        }
+        return ret < 0 ? ret : AVERROR_INVALIDDATA;
+#else
+        return AVERROR(ENOSYS);
+#endif
+    }
+    return 0;
+}
+
+int av_disc_probe(const char *normalized_url,
+                  const AVDictionary *io_options,
+                  AVIOInterruptCB interrupt_cb,
+                  int64_t startup_deadline_us,
+                  enum AVDiscImageType *out_type)
+{
+    DiscIO *io = NULL;
+    void *id = &io;
+    int64_t started_us = av_gettime_relative();
+    uint8_t pvd[ISO_SECTOR_SIZE];
+    IsoDir root;
+    int ret = 0, error, udf_hint = 0, backend_error = 0;
+    const char *stage = "open";
+    const char *protocol = normalized_url ? avio_find_protocol_name(normalized_url) : NULL;
+    enum AVDiscImageType type = AV_DISC_IMAGE_UNKNOWN;
+
+    if (out_type)
+        *out_type = AV_DISC_IMAGE_UNKNOWN;
+    av_log(NULL, AV_LOG_INFO,
+           "[DiscProbe] id=%p begin input=%s bluray_backend=%d dvd_backend=%d\n",
+           id, protocol ? protocol : "unknown", CONFIG_BLURAY_PROTOCOL, CONFIG_DVDVIDEO_DEMUXER);
+    if (!normalized_url || !normalized_url[0]) {
+        ret = AVERROR(EINVAL);
+        goto done;
+    }
+    /* Check before opening even protocols that ignore interrupt callbacks. */
+    if (startup_deadline_us > 0 && started_us >= startup_deadline_us) {
+        ret = AVERROR(ETIMEDOUT);
+        goto done;
+    }
+    if (ff_check_interrupt(&interrupt_cb)) {
+        ret = AVERROR_EXIT;
+        goto done;
+    }
+    io = ff_disc_io_open(normalized_url, io_options, interrupt_cb,
+                         startup_deadline_us, &ret);
+    if (!io)
+        goto done;
+    io->probe_id = id;
+    io->probe_url = normalized_url;
+    io->stage = "seek";
+    av_log(NULL, AV_LOG_INFO, "[DiscProbe] id=%p stage=open size=%"PRId64" seekable=%d\n",
+           id, io->size, io->pb->seekable);
+    ret = verify_random_seek(io);
+    if (ret < 0)
+        goto done;
+
+    io->stage = "descriptor";
+    ret = ff_disc_io_read(io, 16LL * ISO_SECTOR_SIZE, pvd, sizeof(pvd));
+    if (ret < (int)sizeof(pvd)) {
+        ret = ret < 0 ? ret : AVERROR_INVALIDDATA;
+        goto done;
+    }
+    if (pvd[0] == 1 && !memcmp(pvd + 1, "CD001", 5) && pvd[6] == 1 && pvd[156] >= 34) {
+        memcpy(&root.extent, pvd + 158, 4);
+        memcpy(&root.size, pvd + 166, 4);
+        av_log(NULL, AV_LOG_INFO,
+               "[DiscProbe] id=%p stage=iso9660 root_extent=%u root_size=%u\n",
+               id, root.extent, root.size);
+        io->stage = "iso9660";
+        ret = classify_iso9660(io, &root, &type);
+        if (ret < 0)
+            goto done;
+    }
+
+    if (type == AV_DISC_IMAGE_UNKNOWN) {
+        int sector;
+        io->stage = "udf";
+        for (sector = 16; sector < 32; ++sector) {
+            uint8_t desc[ISO_SECTOR_SIZE];
+            ret = ff_disc_io_read(io, (int64_t)sector * ISO_SECTOR_SIZE, desc, sizeof(desc));
+            if (ret < (int)sizeof(desc)) {
+                ret = ret < 0 ? ret : AVERROR_INVALIDDATA;
+                goto done;
+            }
+            if (!memcmp(desc + 1, "NSR02", 5) || !memcmp(desc + 1, "NSR03", 5)) {
+                udf_hint = 1;
+                av_log(NULL, AV_LOG_INFO, "[DiscProbe] id=%p stage=udf marker=%.5s sector=%d\n",
+                       id, desc + 1, sector);
+                break;
+            }
+        }
+    }
+
+    ret = 0;
+    if (type == AV_DISC_IMAGE_UNKNOWN && udf_hint) {
+#if CONFIG_BLURAY_PROTOCOL
+        ret = confirm_bluray(io);
+        if (ret == AVERROR_EXIT || ret == AVERROR(ETIMEDOUT))
+            goto done;
+        if (ret > 0)
+            type = AV_DISC_IMAGE_BLURAY;
+        else if (ret < 0)
+            backend_error = ret;
+#endif
+#if CONFIG_DVDVIDEO_DEMUXER
+        if (type == AV_DISC_IMAGE_UNKNOWN) {
+            ret = confirm_dvd(io);
+            if (ret == AVERROR_EXIT || ret == AVERROR(ETIMEDOUT))
+                goto done;
+            if (ret > 0)
+                type = AV_DISC_IMAGE_DVD;
+            else if (ret < 0 && !backend_error)
+                backend_error = ret;
+        }
+#endif
+#if !CONFIG_BLURAY_PROTOCOL && !CONFIG_DVDVIDEO_DEMUXER
+        backend_error = AVERROR(ENOSYS);
+#endif
+        ret = type == AV_DISC_IMAGE_UNKNOWN ? backend_error : 0;
+    }
+    error = discio_interrupted(io);
+    if (error < 0)
+        ret = error;
+
+done:
+    error = ret < 0 ? map_open_error(ret) :
+            (type == AV_DISC_IMAGE_UNKNOWN ? AV_DISC_ERROR_UNKNOWN_FORMAT : AV_DISC_ERROR_NONE);
+    if (error)
+        type = AV_DISC_IMAGE_UNKNOWN;
+    if (out_type)
+        *out_type = type;
+    if (io)
+        stage = io->stage;
+    av_log(NULL, error ? AV_LOG_WARNING : AV_LOG_INFO,
+           "[DiscProbe] id=%p end stage=%s udf=%d type=%d error=%d raw_error=%d (%s) "
+           "reads=%"PRId64" bytes=%"PRId64" elapsed_ms=%"PRId64"\n",
+           id, stage, udf_hint, type, error, ret < 0 ? ret : 0,
+           ret < 0 ? av_err2str(ret) : "none", io ? io->read_calls : 0,
+           io ? io->bytes_read : 0, (av_gettime_relative() - started_us) / 1000);
+    ff_disc_io_close(&io);
+    return error;
+}
diff --git a/libavformat/disc_io.h b/libavformat/disc_io.h
new file mode 100644
index 0000000..6ce0347
--- /dev/null
+++ b/libavformat/disc_io.h
@@ -0,0 +1,49 @@
+#ifndef AVFORMAT_DISC_IO_H
+#define AVFORMAT_DISC_IO_H
+
+#include "libavformat/avformat.h"
+#include "libavformat/avio.h"
+
+enum AVDiscImageType {
+    AV_DISC_IMAGE_UNKNOWN = 0,
+    AV_DISC_IMAGE_DVD = 1,
