diff --git a/libavformat/dvdisodec.c b/libavformat/dvdisodec.c
new file mode 100644
--- /dev/null
+++ b/libavformat/dvdisodec.c
@@ -0,0 +1,796 @@
+/*
+ * DVD-Video demuxer for ISO images, without libdvdread/libdvdnav
+ *
